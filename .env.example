# Binance Futures API Credentials (Leave empty for Simulation/Paper Trading)
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here
USE_TESTNET=false

# Web Dashboard Admin Credentials
ADMIN_EMAIL=admin@tradingbot.com
ADMIN_PASSWORD=YourSecurePassword123!
SECRET_KEY=generate_a_secure_random_key_here

# Bot Configurations
SIMULATION_MODE=true
TRADE_SYMBOL=BTCUSDT
CANDLE_INTERVAL=1m
LEVERAGE=20

# Risk Management
RISK_PERCENT=2.0
STOP_LOSS_PCT=1.0
TAKE_PROFIT_PCT=2.0

# Strategy Settings
EMA_SHORT=9
EMA_LONG=21
RSI_PERIOD=14
RSI_OVERBOUGHT=70
RSI_OVERSOLD=30
